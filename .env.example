# A dedicated `catalog` schema within the same Postgres instance/database
# as the backend (its role has no CREATEDB privilege for a truly separate
# database) - still fully separate tables/migration history, reached only
# over this service's API, same isolation idea as a separate database.
DATABASE_URL=postgresql+psycopg://voiceorder:changeme@localhost/voiceorder?options=-c%20search_path%3Dcatalog%2Cpublic
# Shared secret the backend must send as X-API-Key. Blank means the check
# is a no-op (same convention as the backend's own api_key setting) -
# fine for local dev, set this before deploying anywhere the port is
# reachable beyond localhost/trusted LAN.
API_KEY=
